FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-prod
DATABASE_URI=sqlite:///quortol.db
SESSION_TIMEOUT=7200
CORS_ORIGINS=http://localhost:8080
PUBLIC_SITE_ORIGIN=https://quortol.pokhi.in
AGENT_API_TIMEOUT=30
REGISTRATION_ENABLED=false

# Public writing autocomplete (llama.cpp server)
LLAMA_CPP_BASE_URL=http://192.168.0.4:8080/v1
LLAMA_CPP_MODEL=local-model
LLAMA_CPP_API_KEY=sk-no-key-required
WRITER_TIMEOUT_SECONDS=30
WRITER_MAX_CONTEXT_CHARS=12000
WRITER_MAX_OUTPUT_TOKENS=64
WRITER_RATE_LIMIT_PER_MINUTE=20
WRITER_MAX_CONCURRENT=2
WRITER_ANALYSIS_MAX_CHARS=50000
WRITER_ANALYSIS_MAX_OUTPUT_TOKENS=2048
WRITER_ANALYSIS_TIMEOUT_SECONDS=90
WRITER_ANALYSIS_RATE_LIMIT_PER_MINUTE=5
UMAMI_ORIGIN=http://127.0.0.1:3001

# Short-form feature
SHORT_FORM_POSTS_JSON=backend/data/short_form/posts.json
SHORT_FORM_MEDIA_DIR=backend/static/short_form
SHORT_FORM_MEDIA_URL_PREFIX=/static/short_form/
SHORT_FORM_PAGE_SIZE=20
SHORT_FORM_MAX_PAGE_SIZE=100

# Frontend analytics (must be available to Vite at build time, for example via shell env or frontend/.env.local)
VITE_UMAMI_ENABLED=false
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_HOST_URL=/umami
VITE_UMAMI_DOMAINS=quortol.pokhi.in
VITE_UMAMI_TRACK_PERFORMANCE=false
