{
  "name": "quortol-frontend",
  "version": "1.0.0",
  "private": true,
  "license": "SEE LICENSE IN ../LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run seo:generate-manifest && npm run seo:generate-sitemap && npm run build:client && npm run build:ssr && npm run seo:prerender && npm run offline:generate",
    "build:client": "node ./scripts/build-client.mjs",
    "build:ssr": "node ./scripts/build-ssr.mjs",
    "preview": "vite preview",
    "serve": "node ./scripts/serve-production.mjs",
    "seo:generate-manifest": "node ./scripts/generate-public-content-manifest.mjs",
    "seo:generate-sitemap": "node ./scripts/generate-sitemap.mjs",
    "seo:prerender": "node ./scripts/prerender-public-routes.mjs",
    "offline:generate": "node ./scripts/generate-service-worker.mjs",
    "test:blog": "vitest run src/utils/__tests__/blogContent.spec.js src/components/blog/BlogTTS.spec.js src/components/blog/BlogRSVP.spec.js src/views/blog/__tests__/BlogDetail.spec.js",
    "test:reader": "vitest run src/services/readerStorage.spec.js src/components/blog/BlogRSVP.spec.js src/components/reader/ContextTextNavigator.spec.js src/views/__tests__/Reader.spec.js src/router/__tests__/index.spec.js",
    "test:short-form": "vitest run src/features/short-form/__tests__",
    "test:podcasts": "vitest run src/views/podcasts/__tests__"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.6.2",
    "bootstrap": "^5.3.3",
    "highlight.js": "^11.11.1",
    "kokoro-js": "^1.2.1",
    "markdown-it": "^14.1.1",
    "onnxruntime-web": "^1.25.1",
    "pinia": "^2.1.7",
    "vue": "^3.3.11",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.6",
    "@vitejs/plugin-vue": "^4.4.1",
    "jsdom": "^24.1.1",
    "vite": "^4.4.11",
    "vitest": "^2.1.8"
  }
}
